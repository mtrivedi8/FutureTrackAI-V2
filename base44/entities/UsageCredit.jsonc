{
  "name": "UsageCredit",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "month": {
      "type": "string",
      "description": "Month in YYYY-MM format"
    },
    "total_cost": {
      "type": "number",
      "description": "Total USD spent this month"
    },
    "blocked": {
      "type": "boolean",
      "description": "Whether the user is blocked for this month"
    }
  },
  "required": [
    "user_email",
    "month",
    "total_cost"
  ]
}