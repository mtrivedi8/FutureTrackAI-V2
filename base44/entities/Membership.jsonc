{
  "name": "Membership",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the member"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "description": "Membership status"
    },
    "checkout_session_id": {
      "type": "string",
      "description": "Wix checkout session ID"
    },
    "order_id": {
      "type": "string",
      "description": "Wix order ID after payment"
    },
    "plan": {
      "type": "string",
      "description": "Plan name, e.g. starter"
    },
    "amount_paid": {
      "type": "string",
      "description": "Amount paid"
    }
  },
  "required": [
    "user_email",
    "status"
  ]
}