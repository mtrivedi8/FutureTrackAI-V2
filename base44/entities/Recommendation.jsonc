{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the teen this recommendation is for"
    },
    "type": {
      "type": "string",
      "enum": [
        "Career Path",
        "Skill",
        "Course",
        "Activity",
        "Project"
      ],
      "description": "Type of recommendation"
    },
    "title": {
      "type": "string",
      "description": "Title of the recommendation"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "why_recommended": {
      "type": "string",
      "description": "Why this was recommended based on the teen's profile"
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ],
      "description": "Difficulty level"
    },
    "estimated_duration": {
      "type": "string",
      "description": "Estimated time to complete or explore"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Useful resources or links"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Exploring",
        "In Progress",
        "Completed",
        "Skipped"
      ],
      "description": "Current status"
    },
    "rating": {
      "type": "number",
      "description": "Teen's rating of this recommendation (1-5)"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "description"
  ]
}