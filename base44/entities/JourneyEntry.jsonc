{
  "name": "JourneyEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "title": {
      "type": "string",
      "description": "Name of the course, activity, or program"
    },
    "type": {
      "type": "string",
      "enum": [
        "School Course",
        "Extracurricular",
        "Sport",
        "Internship",
        "Online Course",
        "Volunteer",
        "Competition",
        "Summer Program",
        "Other"
      ],
      "description": "Type of entry"
    },
    "grade": {
      "type": "number",
      "description": "Grade level when this was done (7-12)"
    },
    "year": {
      "type": "string",
      "description": "Academic year (e.g. 2024-2025)"
    },
    "description": {
      "type": "string",
      "description": "Brief description or notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "Completed",
        "In Progress"
      ],
      "description": "Completion status"
    }
  },
  "required": [
    "user_email",
    "title",
    "type"
  ]
}